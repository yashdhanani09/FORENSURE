@echo off
title SecureData - First-Time Setup
color 0A

:: ??? Self-elevate to Administrator ???????????????????????????????????????????
net session >nul 2>&1
if %errorLevel% == 0 (
    goto :SETUP
) else (
    echo Requesting Administrator privileges...
    powershell -Command "Start-Process '%~f0' -Verb RunAs"
    exit /b
)

:SETUP
setlocal
set SCRIPT_DIR=%~dp0
set BACKEND_DIR=%SCRIPT_DIR%backend
set FRONTEND_DIR=%SCRIPT_DIR%frontend

echo.
echo ============================================================
echo   SecureData Forensics ^& Storage Security - SETUP
echo ============================================================
echo.

:: ??? Check Python ????????????????????????????????????????????????????????????
python --version >nul 2>&1
if errorlevel 1 (
    echo [ERROR] Python not found.
    echo Please install Python 3.11+ from https://www.python.org/downloads/
    echo Make sure to check "Add Python to PATH" during installation.
    pause
    exit /b 1
)
for /f "delims=" %%i in ('python --version 2^>^&1') do set PYVER=%%i
echo [OK] %PYVER% found

:: ??? Check Node.js ???????????????????????????????????????????????????????????
node --version >nul 2>&1
if errorlevel 1 (
    echo [ERROR] Node.js not found.
    echo Please install Node.js 20+ from https://nodejs.org/
    pause
    exit /b 1
)
for /f "delims=" %%i in ('node --version 2^>^&1') do set NODEVER=%%i
echo [OK] Node.js %NODEVER% found

:: ??? Backend: create virtualenv ??????????????????????????????????????????????
echo.
echo [1/5] Setting up Python virtual environment...
if not exist "%BACKEND_DIR%\.wvenv\Scripts\activate.bat" (
    python -m venv "%BACKEND_DIR%\.wvenv"
    if errorlevel 1 (
        echo [ERROR] Failed to create virtual environment.
        pause
        exit /b 1
    )
    echo [OK] Virtual environment created.
) else (
    echo [OK] Virtual environment already exists.
)

:: ??? Backend: install dependencies ???????????????????????????????????????????
echo.
echo [2/5] Installing backend dependencies...
call "%BACKEND_DIR%\.wvenv\Scripts\activate.bat"
pip install --upgrade pip --quiet
pip install -r "%BACKEND_DIR%\requirements.txt" --quiet
if errorlevel 1 (
    echo [ERROR] pip install failed. Check your internet connection.
    pause
    exit /b 1
)
echo [OK] Backend dependencies installed.

:: ??? Backend: run DB migrations ??????????????????????????????????????????????
echo.
echo [3/5] Initialising database...
cd /d "%BACKEND_DIR%"
python -m alembic upgrade head >nul 2>&1
echo [OK] Database ready.

:: ??? Frontend: npm install ???????????????????????????????????????????????????
echo.
echo [4/5] Installing frontend dependencies (this may take a minute)...
cd /d "%FRONTEND_DIR%"
npm install --silent
if errorlevel 1 (
    echo [ERROR] npm install failed. Check your internet connection.
    pause
    exit /b 1
)
echo [OK] Frontend dependencies installed.

:: ??? Create .env if it doesn't exist ?????????????????????????????????????????
echo.
echo [5/5] Creating configuration file...
if not exist "%SCRIPT_DIR%.env" (
    copy "%SCRIPT_DIR%.env.example" "%SCRIPT_DIR%.env" >nul
    echo [OK] .env created from template.
) else (
    echo [OK] .env already exists.
)

echo.
echo ============================================================
echo   SETUP COMPLETE!
echo   Run START.bat to launch the application.
echo ============================================================
echo.
pause
