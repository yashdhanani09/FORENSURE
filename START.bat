@echo off
title SecureData - Starting...
color 0B

:: ??? Self-elevate to Administrator ???????????????????????????????????????????
net session >nul 2>&1
if %errorLevel% == 0 (
    goto :START
) else (
    echo Requesting Administrator privileges...
    powershell -Command "Start-Process '%~f0' -Verb RunAs"
    exit /b
)

:START
setlocal
set SCRIPT_DIR=%~dp0
set BACKEND_DIR=%SCRIPT_DIR%backend
set FRONTEND_DIR=%SCRIPT_DIR%frontend

:: ??? Verify setup was done ????????????????????????????????????????????????????
if not exist "%BACKEND_DIR%\.wvenv\Scripts\activate.bat" (
    echo [ERROR] Virtual environment not found.
    echo Please run SETUP.bat first.
    pause
    exit /b 1
)
if not exist "%FRONTEND_DIR%\node_modules" (
    echo [ERROR] Frontend node_modules not found.
    echo Please run SETUP.bat first.
    pause
    exit /b 1
)

echo.
echo ============================================================
echo   SecureData Forensics ^& Storage Security
echo   Starting servers...
echo ============================================================
echo.
echo [*] Backend  ? http://127.0.0.1:8000
echo [*] Frontend ? http://localhost:5174
echo.

:: ??? Start backend in new elevated window ????????????????????????????????????
start "SecureData Backend" /D "%BACKEND_DIR%" cmd /k "call .wvenv\Scripts\activate.bat && uvicorn app.main:app --host 127.0.0.1 --port 8000 --reload"

:: ??? Wait 3 seconds for backend to boot ??????????????????????????????????????
timeout /t 3 /nobreak >nul

:: ??? Start frontend ???????????????????????????????????????????????????????????
start "SecureData Frontend" /D "%FRONTEND_DIR%" cmd /k "npm run dev"

:: ??? Wait for frontend to boot then open browser ????????????????????????????
timeout /t 4 /nobreak >nul
start "" "http://localhost:5174"

echo.
echo [OK] Both servers are running.
echo      Close the Backend and Frontend windows to stop the app.
echo.
pause
